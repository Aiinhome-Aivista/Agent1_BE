# Database
DATABASE_URL=

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=



# CORS
FRONTEND_URL=http://localhost:5173

# Polling intervals (seconds)
PIPELINE_SYNC_INTERVAL=260
LOG_FETCH_INTERVAL=230

# Redis (optional - for distributed tasks)
REDIS_URL=redis://localhost:6379/0


SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=


# NEW — escalation delay. Default is 15 minutes if missing.
INCIDENT_ESCALATION_MINUTES=15


# ===== LLM (Mistral Cloud / Local) =====
# Switch between modes at runtime via POST /api/v1/llm/mode
# or just edit this value and restart.
MISTRAL_MODE=Local

# --- Cloud mode credentials ---
MISTRAL_API_KEY=
MODEL_NAME=mistral-small-latest
# (kept for back-compat with the old mistral_service)
MISTRAL_MODEL=mistral-small-latest

# --- Local mode (Ollama / vLLM / LM Studio — any OpenAI-compatible) ---
# NOTE: 'mistral:latest' is the Ollama model name (run `ollama pull mistral`).
# The URL must be reachable from wherever the backend runs.
MISTRAL_LOCAL_URL=
MISTRAL_LOCAL_MODEL=mistral:latest

# --- Generation knobs (apply to BOTH modes) ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000


# ===== ArangoDB (Graph layer) =====
ARANGO_ENABLED=true
ARANGO_URL=
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=pipeline_graph

# How many graph-ranked fix candidates to inject into the LLM prompt
# (in addition to whatever Chroma RAG already retrieves).
GRAPH_RAG_TOP_K=5
