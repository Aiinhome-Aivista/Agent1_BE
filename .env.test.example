# Database
DATABASE_URL=mysql+pymysql://aiinhome:password@host:3306/pipeline_monitor

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=oRq0b5GJUQ_sj9POT9XEDZyB2lL-T3wwWaSvQQ_A1_A=


# CORS
FRONTEND_URL=http://localhost:5173

# Polling intervals (seconds)
PIPELINE_SYNC_INTERVAL=60
LOG_FETCH_INTERVAL=30

# Redis (optional - for distributed tasks)
REDIS_URL=


SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=


# Jira Configuration
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_HUMAN_ASSIGNEE_ACCOUNT_ID=

# ╔══════════════════════════════════════════════════════════════════╗
# ║                ADD THESE TO YOUR EXISTING .env                    ║
# ╚══════════════════════════════════════════════════════════════════╝

# ===== LLM (Mistral Cloud / Local) =====
# Switch between modes at runtime via POST /api/v1/llm/mode
# or just edit this value and restart.
MISTRAL_MODE=Local

# --- Cloud mode credentials ---
MISTRAL_API_KEY=
MODEL_NAME=
# (kept for back-compat with the old mistral_service)
MISTRAL_MODEL=

# --- Local mode (Ollama / vLLM / LM Studio — any OpenAI-compatible) ---
# The URL must be reachable from wherever the backend runs.
MISTRAL_LOCAL_URL=
MISTRAL_LOCAL_MODEL=


# --- Generation knobs (apply to BOTH modes) ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000


# ===== ArangoDB (Graph layer) =====
ARANGO_ENABLED=true
ARANGO_URL=
ARANGO_USER=
ARANGO_PASSWORD=
ARANGO_DB=pipeline_graph

# How many graph-ranked fix candidates to inject into the LLM prompt
# (in addition to whatever Chroma RAG already retrieves).
GRAPH_RAG_TOP_K=5
