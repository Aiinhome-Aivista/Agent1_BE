# Database
DATABASE_URL=mysql+pymysql://aiinhome:password@72.61.226.68:3306/pipeline_monitor

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=

# CORS
FRONTEND_URL=http://localhost:5173

# Polling intervals (seconds)
PIPELINE_SYNC_INTERVAL=260
LOG_FETCH_INTERVAL=230

# Redis (optional - for distributed tasks)
REDIS_URL=redis://localhost:6379/0

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Escalation delay. Default is 15 minutes if missing.
INCIDENT_ESCALATION_MINUTES=15

# --- Mistral -------------------------------------------------------------
# ===== LLM (Mistral Cloud / Local) =====
# Switch between modes at runtime via POST /api/v1/llm/mode
MISTRAL_MODE=Local

# --- Cloud mode credentials ---
MISTRAL_API_KEY=
MODEL_NAME=mistral-small-latest
# back-compat alias
MISTRAL_MODEL=mistral-small-latest

# --- Local mode (Ollama / vLLM / LM Studio — any OpenAI-compatible endpoint) ---
MISTRAL_LOCAL_URL=
MISTRAL_LOCAL_MODEL=mistral:latest

# --- Generation knobs (apply to BOTH modes) ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# ===== ArangoDB (Graph layer) =====
ARANGO_ENABLED=true
ARANGO_URL=
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=pipeline_graph
GRAPH_RAG_TOP_K=5

# --- Test execution flags ------------------------------------------------
# Set to 1 to enable destructive tests (e.g. files a real GitHub issue):
# RUN_DESTRUCTIVE_TESTS=1

# ===== Jira Integration =====
# Fill these in with your real Atlassian credentials.
# NEVER expose these to the frontend — they are read only by jira_service.py.
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Jira accountId of the human DataOps assignee (used in Scenario B)
JIRA_HUMAN_ASSIGNEE_ACCOUNT_ID=
# Confidence threshold: >= this value -> Scenario A (AI PR), < this -> Scenario B (human)
JIRA_HIGH_CONFIDENCE_THRESHOLD=0.7
